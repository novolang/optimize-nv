// optscalar_tests.nv — one variable, and a bracket that shrinks.
//
// RED ON PURPOSE: every assertion reaches `not implemented:
// optimize-nv.optscalar.<fn>`.
//
// The oracle is `f(x) = (x - 2)^2`, whose minimum is exactly 0 at
// x = 2 and which is bracketed by [0, 5].  It is the simplest function
// on which every claim these methods make is checkable by hand.

use std.test
use optscalar
use optstop

fn quadratic(x: Float) -> Float
    (x - 2.0) * (x - 2.0)

fn no_minimum(x: Float) -> Float
    x

@test
fn test_brent_finds_the_minimum_of_a_quadratic_and_says_it_converged() [io]
    let rule = optstop.with_point_tolerance(optstop.budgeted(100), 0.00000001)

    test.case("the point is 2 and the value is 0")
    match optscalar.brent(quadratic, 0.0, 5.0, rule)
        Err(e) => test.fail(e.message())
        Ok(r)  =>
            test.assert_approx(r.point[0], 2.0, 0.000001)
            test.assert_approx(r.value, 0.0, 0.000001)

    test.case("and the status says converged, not merely finished")
    match optscalar.brent(quadratic, 0.0, 5.0, rule)
        Err(e) => test.fail(e.message())
        Ok(r)  => test.assert(optstop.converged(r))

    test.case("a one-dimensional report still carries a point list, so both shapes read alike")
    match optscalar.brent(quadratic, 0.0, 5.0, rule)
        Err(e) => test.fail(e.message())
        Ok(r)  => test.assert(list.len(r.point) == 1)

@test
fn test_golden_section_gets_the_same_answer_more_slowly() [io]
    let rule = optstop.with_point_tolerance(optstop.budgeted(200), 0.000001)

    test.case("the same minimum")
    match optscalar.golden_section(quadratic, 0.0, 5.0, rule)
        Err(e) => test.fail(e.message())
        Ok(r)  => test.assert_approx(r.point[0], 2.0, 0.00001)

    test.case("and its evaluation count is a function of the tolerance alone")
    // The bracket shrinks by a constant factor every step whatever the
    // function does, which is the property that makes this method
    // impossible to fool and its cost predictable.
    match optscalar.golden_section(quadratic, 0.0, 5.0, rule)
        Err(e) => test.fail(e.message())
        Ok(r)  =>
            test.assert(r.evaluations > 20)
            test.assert(r.evaluations < 60)

@test
fn test_a_budget_that_is_too_small_says_budget_exhausted_and_not_converged() [io]
    // The distinction the status type exists for.  Three iterations on
    // this function is not a minimum, and the report must not claim it
    // is.
    test.case("three iterations, and the report is honest about it")
    match optscalar.brent(quadratic, 0.0, 5.0, optstop.budgeted(3))
        Err(e) => test.fail(e.message())
        Ok(r)  =>
            test.assert(not optstop.converged(r))
            test.assert_eq_str(optstop.status_name(r.status), "budget exhausted")

@test
fn test_a_bracket_that_does_not_bracket_is_refused_before_the_first_evaluation() [io]
    test.case("lower above upper")
    match optscalar.brent(quadratic, 5.0, 0.0, optstop.budgeted(100))
        Ok(_)  => test.fail("5 is not below 0")
        Err(_) => test.assert(true)

    test.case("an empty interval")
    match optscalar.golden_section(quadratic, 2.0, 2.0, optstop.budgeted(100))
        Ok(_)  => test.fail("an interval of no width brackets nothing")
        Err(_) => test.assert(true)

@test
fn test_is_bracket_states_the_rule_the_two_methods_assume() [io]
    test.case("0, 2, 5 brackets the minimum of the quadratic")
    test.assert(optscalar.is_bracket(quadratic, 0.0, 2.0, 5.0))

    test.case("0, 4, 5 does not — the middle is not below both ends")
    test.assert(not optscalar.is_bracket(quadratic, 0.0, 4.0, 5.0))

    test.case("and a straight line brackets nothing anywhere")
    test.assert(not optscalar.is_bracket(no_minimum, 0.0, 1.0, 2.0))

@test
fn test_bracket_from_walks_downhill_until_it_has_three_points() [io]
    test.case("from 0 and 1 on the quadratic it finds a bracket around 2")
    match optscalar.bracket_from(quadratic, 0.0, 1.0, optstop.budgeted(50))
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            test.assert(list.len(b) == 3)
            test.assert(optscalar.is_bracket(quadratic, b[0], b[1], b[2]))

    test.case("on a function with no minimum it gives up rather than walking for ever")
    match optscalar.bracket_from(no_minimum, 0.0, 1.0, optstop.budgeted(20))
        Ok(_)  => test.fail("a straight line has no minimum to bracket")
        Err(_) => test.assert(true)
