// optsimplex.nv — Nelder-Mead: the method that needs no derivative and
// no random number.
//
// WHAT IT DOES.  A simplex in `n` dimensions is `n + 1` points — a
// triangle in two dimensions, a tetrahedron in three.  Nelder-Mead
// evaluates the objective at each vertex, and then, at every
// iteration, moves the worst vertex through the centroid of the
// others: reflect it, and if the reflection is the best point so far
// expand further; if the reflection is no better than the
// second-worst, contract instead; and if nothing helps, shrink the
// whole simplex toward its best vertex.  The four coefficients of
// those moves are the caller's, with the classic values as the
// default constructor.
//
// It uses only function VALUES.  No derivative, no line search, no
// linear algebra.  That is why it is the method for an objective that
// is a simulation, a table lookup or anything else with no gradient to
// take, and why it is also the method that converges slowly and can
// stall on a ridge.  `OptStalled` is not a rare outcome here; it is
// the honest report of a simplex that collapsed, and it is the reason
// the status type has that arm.
//
// THE INITIAL SIMPLEX IS THE CALLER'S.  Every other implementation
// builds it by perturbing the starting point, and most of them use a
// random perturbation — which makes the run irreproducible and makes
// this package impossible to write as `core`, because a `core` package
// may not draw one.  Here the simplex is an argument.
// `simplex_around` builds the usual deterministic one from a point and
// a step, so a caller who does not care writes one extra call; a
// caller who does care — because the coordinates have different units,
// which is the case the automatic perturbation always gets wrong —
// hands over the vertices it wants.

// The coefficients of the four moves.
//
// The classic values are reflection 1, expansion 2, contraction 0.5
// and shrink 0.5, and `classic_moves` is them.  They are here as a
// value because the adaptive variants that scale them with the
// dimension are a change of these four numbers and nothing else.
//
// ```novo
// use optsimplex
//
// fn main() [io]
//     println("${optsimplex.classic_moves().reflection}")   // 1
// ```
pub struct OptSimplexMoves
    // How far the worst vertex is reflected through the centroid.
    reflection: Float
    // How much further it goes when the reflection was the best point
    // yet.
    expansion: Float
    // How far back it comes when the reflection was no improvement.
    contraction: Float
    // How far every vertex moves toward the best one when nothing
    // else helped.
    shrink: Float

// The classic coefficients: 1, 2, 0.5, 0.5.
//
// ```novo
// use optsimplex
//
// fn main() [io]
//     println("${optsimplex.classic_moves().expansion}")   // 2
// ```
pub fn classic_moves() -> OptSimplexMoves
    todo("optimize-nv.optsimplex.classic_moves")

// The minimum of `f` from this initial simplex.
//
// `vertices` is `n + 1` points of `n` coordinates each;
// `OptBadSimplex` when it is not, carrying both counts.  The report's
// point is the best vertex at the end, and its status distinguishes a
// met tolerance from an exhausted budget from a collapsed simplex.
//
// ```novo
// use optsimplex
// use optstop
//
// fn sphere(x: [Float]) -> Float
//     x[0] * x[0] + x[1] * x[1]
//
// fn main() [io]
//     match optsimplex.simplex_around([1.0, 1.0], 0.5)
//         Err(e) => println(e.message())
//         Ok(s)  =>
//             let rule = optstop.with_point_tolerance(optstop.budgeted(500), 0.00000001)
//             match optsimplex.nelder_mead(sphere, s, optsimplex.classic_moves(), rule)
//                 Ok(r)  => println("${r.value}")   // 0
//                 Err(e) => println(e.message())
// ```
pub fn nelder_mead(f: fn([Float]) -> Float, vertices: [[Float]], moves: OptSimplexMoves,
                   rule: OptStop) -> Result<OptReport, OptFault>
    todo("optimize-nv.optsimplex.nelder_mead")

// The usual initial simplex around a point: the point itself, and one
// vertex per coordinate with that coordinate moved by `step`.
//
// Deterministic, so two runs from the same point give the same
// answer.  `OptEmptyStart` when the point has no coordinates and
// `OptBadSetting` when the step is zero, since a simplex with two
// identical vertices is degenerate from the first iteration.
//
// A caller whose coordinates have different units — metres and
// seconds, say — should build the vertices itself, because one step
// for all of them is a step that is too large in one unit and too
// small in the other.
//
// ```novo
// use optsimplex
//
// fn main() [io]
//     match optsimplex.simplex_around([0.0, 0.0], 1.0)
//         Ok(s)  => println("${list.len(s)}")   // 3
//         Err(e) => println(e.message())
// ```
pub fn simplex_around(start: [Float], step: Float) -> Result<[[Float]], OptFault>
    todo("optimize-nv.optsimplex.simplex_around")

// The usual initial simplex with a step per coordinate.
//
// The form for coordinates in different units: one step each, in the
// units of that coordinate.  `OptBadSimplex` when the two lists are
// different lengths.
//
// ```novo
// use optsimplex
//
// fn main() [io]
//     match optsimplex.simplex_with_steps([0.0, 0.0], [1.0, 0.001])
//         Ok(s)  => println("${list.len(s)}")   // 3
//         Err(e) => println(e.message())
// ```
pub fn simplex_with_steps(start: [Float], steps: [Float]) -> Result<[[Float]], OptFault>
    todo("optimize-nv.optsimplex.simplex_with_steps")

// How far apart the vertices of a simplex are: the largest distance
// from any vertex to the best one.
//
// The quantity `point_tolerance` is tested against, written out so a
// caller can see how close the simplex got and so a test can assert
// it.
//
// ```novo
// use optsimplex
//
// fn main() [io]
//     match optsimplex.simplex_around([0.0, 0.0], 1.0)
//         Ok(s)  => println("${optsimplex.simplex_size(s)}")   // 1
//         Err(e) => println(e.message())
// ```
pub fn simplex_size(vertices: [[Float]]) -> Float
